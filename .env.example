# Docker Compose 配置
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=st_smart_test
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 后端安全与运行配置
APP_TITLE=智测
APP_VERSION=1.0.0
ROOT_PATH=
SECRET_KEY=change-this-to-a-random-long-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
DEBUG=true
ENABLE_API_DOCS=true
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_CONCURRENT=3
SCHEDULE_POLICY_DEFAULT_MAX_REFERENCES=3
AI_PLATFORM_MAX_CONCURRENT=3
FILE_MOUNT_ROOT=/mnt
# 仅在确认备份和删除范围后临时设为 true，执行完破坏性迁移后恢复 false
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# 高德地图 Web 服务 API Key
AMAP_WEB_SERVICE_KEY=

# OSS 文件存储；本地开发可保持 false
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=smart-test-uploads
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_PREFIX=https://smart-test-uploads.oss-cn-hangzhou.aliyuncs.com
